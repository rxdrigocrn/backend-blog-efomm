model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String
  actorRole  Role
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType])
  @@index([action])
}

enum Role {
  PRESIDENTE
  REDATOR
}
